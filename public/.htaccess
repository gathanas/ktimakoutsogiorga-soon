# Apache config for the Papaki shared host. Copied verbatim into dist/ by Vite's
# publicDir, so it ships with every build.
#
# NOTE: there is deliberately no http->https redirect here. TLS is terminated by
# nginx in front of Apache, which already 301s http->https. Apache therefore sees
# plain http on every request, so a `RewriteCond %{HTTPS} off` rule would match
# forever and loop.

# The host auto-provisions WordPress on a fresh account; an index.php left behind
# would otherwise win over our index.html.
DirectoryIndex index.html

<IfModule mod_rewrite.c>
RewriteEngine On

# Canonical host. Every canonical/og:url in the build names the www form, so send
# the bare domain there rather than serving both with a 200.
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^(.*)$ https://www.%{HTTP_HOST}/$1 [R=301,L]

# Canonical path: /wines/mandolino.html -> /wines/mandolino, matching the
# extensionless URLs published in llms.txt and printed on the bottle QR codes.
# Matched against THE_REQUEST (the literal request line) rather than the current
# URI, so the internal rewrite below cannot feed these rules and loop.
#
# Both targets are absolute https URLs. A relative target would make Apache build
# the Location from the scheme it sees, which is http behind nginx — turning one
# redirect into an http hop plus a second nginx redirect back to https. HTTP_HOST
# is already the www form here because the rule above redirected the bare domain.

# The -f guard keeps a request for a .html file that does not exist a plain 404,
# rather than a 301 pointing at a 404.

# index.html belongs at the directory root, not at /index.
RewriteCond %{REQUEST_FILENAME} -f
RewriteCond %{THE_REQUEST} \s/+(?:(.+)/)?index\.html[\s?] [NC]
RewriteRule ^ https://%{HTTP_HOST}/%1 [R=301,L]

RewriteCond %{REQUEST_FILENAME} -f
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ https://%{HTTP_HOST}/%1 [R=301,L]

# Serve the extensionless URL from the .html file the build emits. Only fires
# when that file actually exists, so real 404s stay 404s.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ /$1.html [L]
</IfModule>
